# ── Supabase (프로젝트 설정 › API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 웹툰보드 테이블 구역(스키마) · 버킷 — 공용 프로젝트(iux-cloud)에 얹어도 안 섞이게 (보통 그대로 두세요)
NEXT_PUBLIC_SUPABASE_DB_SCHEMA=webtoon
SUPABASE_BUCKET=webtoon
SUPABASE_READ_BUCKET=webtoon-read

# ── (시험 배포) 사이트 전체 비밀번호 잠금 — 넣으면 들어올 때 비밀번호를 물어요 (아이디는 아무거나)
SITE_PASSWORD=

# ── 사이트 주소 (로그인 메일 · OAuth 돌아올 주소)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 관리자: 이 이메일로 가입하면 자동으로 관리자 (쉼표로 여러 개)
ADMIN_EMAILS=handgoldking@akiaka.com

# ── 글 AI (Claude API)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ── 이미지 AI (Gemini API · 나노바나나)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_MODEL_PRO=gemini-3-pro-image

# ── 무료 한도 · 비용 (원)
FREE_TEXT_PER_MONTH=30
FREE_IMAGE_TOTAL=10
PRO_TEXT_PER_MONTH=1000
PRO_IMAGE_PER_MONTH=300
AI_MONTHLY_BUDGET_KRW=500000
COST_TEXT_KRW=15
COST_IMAGE_KRW=55
COST_IMAGE_PRO_KRW=180

# ── (선택) OpenAI — 관리자 › 설정에서 엔진을 OpenAI로 바꿀 때
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-2
# 기본 엔진 (관리자 설정이 있으면 그게 우선)
AI_TEXT_ENGINE=claude
AI_IMAGE_ENGINE=gemini

# ── (선택) 그림 · 작품 파일을 Cloudflare R2에 저장 (비우면 Supabase Storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# (선택) 연재관 그림 전용 공개 버킷 + 공개 주소 (예: https://img.toon.iux.kr) — 비우면 Supabase 'webtoon-read' 버킷
R2_READ_BUCKET=
R2_PUBLIC_URL=

# ── (선택) 메일 — 문의 답변 · 새 문의 알림 (Resend)
RESEND_API_KEY=
MAIL_FROM=웹툰보드 <noreply@your-domain.com>
