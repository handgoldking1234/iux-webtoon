# ── Supabase (프로젝트 설정 › API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 사이트 주소 (로그인 메일 · OAuth 돌아올 주소)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 관리자: 이 이메일로 가입하면 자동으로 관리자 (쉼표로 여러 개)
ADMIN_EMAILS=handgoldking@akiaka.com

# ── 글 AI (Claude API)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ── 이미지 AI (Gemini API · 나노바나나)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_IMAGE_MODEL_PRO=gemini-3-pro-image-preview

# ── 무료 한도 · 비용 (원)
FREE_TEXT_PER_MONTH=30
FREE_IMAGE_TOTAL=10
PRO_TEXT_PER_MONTH=1000
PRO_IMAGE_PER_MONTH=300
AI_MONTHLY_BUDGET_KRW=500000
COST_TEXT_KRW=15
COST_IMAGE_KRW=55
COST_IMAGE_PRO_KRW=180
